# Crimson OS — operator environment (copy to .env, never commit .env)

# Canonical NAS mount (operator estate)
COS_ROOT=Y:\COS

# Intranet (Agent_Bridge static host)
INTRANET_HOST=127.0.0.1
INTRANET_PORT=8092

# Cockpit API (Node 1 Q)
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=8093

# Build log (epistemic gate stub)
BUILD_LOG_PATH=./build_log.jsonl

# Local inference (optional)
OLLAMA_HOST=http://127.0.0.1:11434

# Frontier APIs — publishable research only (never biometrics/finance)
# GROK_API_KEY=
# ANTHROPIC_API_KEY=